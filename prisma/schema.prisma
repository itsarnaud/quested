// Prisma schema for Quested
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js required models ---
// https://authjs.dev/getting-started/adapters/prisma

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  providerLabel     String? // display identity on that provider (username/email), for the account settings UI

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?   @db.Text
  website       String?
  twitterUrl    String?
  twitchUrl     String?
  youtubeUrl    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  logs     Log[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  notificationsReceived Notification[] @relation("NotificationsReceived")
  notificationsSent     Notification[] @relation("NotificationsSent")

  likes Like[]

  favoriteGames FavoriteGame[]

  gameLists GameList[]

  pushSubscriptions PushSubscription[]

  achievements       UserAchievement[]
  pinnedAchievements PinnedAchievement[]

  badges Badge[] @default([])

  // Off by default — transactional emails (welcome, account deletion)
  // always send regardless of these.
  emailOnFollow  Boolean @default(false)
  emailOnLike    Boolean @default(false)
  emailOnRelease Boolean @default(false)

  // Off by default — showing a linked account publicly is an explicit
  // opt-in, not the default just because it's linked.
  showSteamOnProfile   Boolean @default(false)
  showDiscordOnProfile Boolean @default(false)
}

enum Badge {
  FOUNDER
  EARLY_ADOPTER
  BETA_TESTER
  BUG_HUNTER
  CONTRIBUTOR
  SUPPORTER
}

model GameList {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  items GameListItem[]

  @@index([userId])
}

model GameListItem {
  id       String @id @default(cuid())
  position Int

  list   GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId String

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String

  @@unique([listId, gameId])
  @@unique([listId, position])
  @@index([listId])
}

model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  follower   User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String

  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user   User   @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  actor   User?   @relation("NotificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
  actorId String?

  log   Log?    @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId String?

  game   Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String?

  @@unique([userId, gameId, type])
  @@index([userId, read])
  @@index([createdAt])
}

enum NotificationType {
  FOLLOW
  LIKE
  RELEASE
}

// One row per subscribed browser/device, so a user can have push enabled on
// several devices at once and each can be dropped independently (e.g. when
// the browser reports the subscription as expired).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

enum GameStatus {
  BACKLOG
  PLAYING
  COMPLETED
  DROPPED
  WISHLIST
}

// A game aggregated from external sources (IGDB, RAWG, ...), deduplicated
// into a single canonical entry that logs point to.
model Game {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  releaseYear Int?
  releaseDate DateTime?
  coverUrl    String?
  summary     String?   @db.Text
  genres      String[]  @default([])
  platforms   String[]  @default([])
  developers  String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  externalIds   GameExternalId[]
  logs          Log[]
  favoritedBy   FavoriteGame[]
  listItems     GameListItem[]
  notifications Notification[]
  achievements  Achievement[]

  @@index([title])
}

model FavoriteGame {
  id       String @id @default(cuid())
  position Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String

  @@unique([userId, gameId])
  @@unique([userId, position])
  @@index([userId])
}

enum GameSource {
  IGDB
  RAWG
  STEAM
}

// Maps a canonical Game to its id in each external source, so the
// dedup/matching job can tell "already imported" apart from "new game".
model GameExternalId {
  id       String     @id @default(cuid())
  source   GameSource
  sourceId String

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String

  @@unique([source, sourceId])
  @@index([gameId])
}

model Log {
  id            String     @id @default(cuid())
  status        GameStatus @default(BACKLOG)
  rating        Float? // 0-10, one decimal place, null if not rated yet
  notes         String?    @db.Text
  minutesPlayed Int? // total playtime, currently only populated by Steam sync
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String

  likes         Like[]
  notifications Notification[]

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

// One row per (canonical Game, Steam achievement) — shared across all
// users, fetched once per game from GetSchemaForGame and reused forever.
model Achievement {
  id                    String  @id @default(cuid())
  apiName               String
  displayName           String
  description           String? @db.Text
  iconUrl               String
  iconGrayUrl           String
  globalUnlockedPercent Float?

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String

  unlockedBy UserAchievement[]
  pinnedBy   PinnedAchievement[]

  @@unique([gameId, apiName])
  @@index([gameId])
}

// Only unlocked achievements get a row — "locked" is just "no row exists"
// for that (user, achievement) pair, so this table only grows with actual
// progress instead of being pre-populated for every possible achievement.
model UserAchievement {
  id         String    @id @default(cuid())
  unlockedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

// A user's chosen highlight reel of unlocked achievements to show on their
// profile — same shape as FavoriteGame (position-ordered, capped client-side).
model PinnedAchievement {
  id       String @id @default(cuid())
  position Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String

  @@unique([userId, achievementId])
  @@unique([userId, position])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  log   Log    @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId String

  @@unique([userId, logId])
  @@index([logId])
}
